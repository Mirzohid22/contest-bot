# Admin panel behind nginx, for a server where nginx already owns ports 80 and 443.
#
#   sudo cp nginx-site.conf.example /etc/nginx/sites-available/contest-admin
#   sudo sed -i 's/admin.example.com/your.real.domain/' /etc/nginx/sites-available/contest-admin
#   sudo ln -s /etc/nginx/sites-available/contest-admin /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d your.real.domain
#
# Then set PUBLIC_URL=https://your.real.domain in .env and restart the app.

server {
    listen 80;
    server_name admin.example.com;

    # Metrics stay private; read them on the server at 127.0.0.1:3200/metrics.
    location = /metrics { return 404; }

    location / {
        proxy_pass http://127.0.0.1:3200;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
