# Copy to .env and fill in. Never commit .env.

# From @BotFather.
BOT_TOKEN=

# Comma-separated Telegram user ids allowed to use /admin and the admin panel.
# Get yours from @userinfobot.
ADMIN_IDS=

# Postgres credentials used by docker compose (the app's DATABASE_URL is built from them).
# Use only letters and digits in the password: it is placed inside a URL.
POSTGRES_USER=contest
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=contest

# Port on the server's localhost where the admin panel listens.
ADMIN_PORT=3200

# Where you open the admin panel. Login links sent by /admin use this.
# Through an SSH tunnel (ssh -L 3200:127.0.0.1:3200 user@server): http://localhost:3200
# Behind your web server with a domain: https://admin.example.com
PUBLIC_URL=http://localhost:3200

# Optional. Defaults are in compose.yml and src/config.ts.
# IMAGE=ghcr.io/mirzohid22/contest-bot:latest
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE_SIZE=768MB
# PG_MEM_LIMIT=512m
# APP_MEM_LIMIT=768m
# LOG_LEVEL=info
# SEND_RATE=25
# SEND_RATE_MAX=30
