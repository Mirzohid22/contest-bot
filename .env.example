# Copy to .env and fill in. Never commit .env.

# From @BotFather.
BOT_TOKEN=

# Comma-separated Telegram user ids allowed to use /admin and the admin panel.
# Get yours from @userinfobot.
ADMIN_IDS=

# Postgres credentials used by docker compose (the app's DATABASE_URL is built from them).
POSTGRES_USER=contest
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=contest

# Where the admin panel is reachable. Login links sent by /admin use this.
# With a domain and the "https" compose profile: https://admin.example.com
# Without a domain, keep the default and open an SSH tunnel:
#   ssh -L 3000:127.0.0.1:3000 user@your-vps
PUBLIC_URL=http://localhost:3000

# Only needed with the "https" compose profile (Caddy gets the certificate).
ADMIN_DOMAIN=

# Optional tuning. Defaults are in src/config.ts.
# LOG_LEVEL=info
# SEND_RATE=25
# SEND_RATE_MAX=30
